
# ===========================
# API Configuration (PÚBLICO)
# ===========================
# Next.js requiere NEXT_PUBLIC_ para variables accesibles en el navegador
NEXT_PUBLIC_API_ROOT=https://apiadministrador.upea.bo
NEXT_PUBLIC_API_BASE=https://apiadministrador.upea.bo/api/v2
NEXT_PUBLIC_API_TOKEN= 

# ===========================
# Institución Actual
# ===========================
# Para Ciencias de la Educación (ID: 12) 
#NEXT_PUBLIC_INSTITUCION_ID=12

# Para Artes plasticas (ID: 18) 
#NEXT_PUBLIC_INSTITUCION_ID=18


# Para Medicina Veterinaria (ID: 20) 
NEXT_PUBLIC_INSTITUCION_ID=20

# ===========================
# Assets & Media
# ===========================
NEXT_PUBLIC_STORAGE_URL=https://apiadministrador.upea.bo/storage

# ===========================
# App Settings
# ===========================
NEXT_PUBLIC_ENV=production